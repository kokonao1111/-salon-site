# サイトの公開段階。preview | prelaunch | live
# 未設定または不正な値の場合は、最も安全な "preview"（全面noindex・全面クロール禁止）になる。
# live にすると、正式店舗名（siteConfig.brand.status）と本番URLの両方が確定していない限り
# ビルド自体が失敗する安全装置が入っている。
NEXT_PUBLIC_SITE_STAGE=preview

# 本番ドメイン確定後に設定。未設定の間は canonical / sitemap / OGP に一切URLを出力しない
# （仮ドメインを検索エンジン・SNSに渡さないため）。
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager コンテナID（例: GTM-XXXXXXX）。未設定の間はGTMを一切読み込まない
NEXT_PUBLIC_GTM_ID=

# GA4 測定ID（GTM経由で管理しない場合のみ使用）
NEXT_PUBLIC_GA_ID=

# Google広告 コンバージョンID
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# Google Search Console の所有権確認コード（meta タグ用）。未設定の間はタグを出力しない
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

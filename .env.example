# 本番ドメイン確定後に設定（未設定時は仮のプレースホルダードメインを使用）
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager コンテナID（例: GTM-XXXXXXX）。未設定の間はGTMを一切読み込まない
NEXT_PUBLIC_GTM_ID=

# GA4 測定ID（GTM経由で管理しない場合のみ使用）
NEXT_PUBLIC_GA_ID=

# Google広告 コンバージョンID
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# Google Search Console の所有権確認コード（meta タグ用）。未設定の間はタグを出力しない
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
